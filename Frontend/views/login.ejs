<head>
  <link rel="stylesheet" href="/styles/login.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=Noto+Serif:wght@600;700&display=swap" rel="stylesheet">
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>

<main>
  <div class="logo">
    <img src="/imag/LogoLenedly-removebg-preview.png" alt="Lendly Logo">
  </div>

  <div class="wrapper">
    <form id="loginForm" method="POST" action="/api/auth/login">
      <div class="login-card__header">
        <h1>Lendly</h1>
        <p>เข้าสู่ระบบเพื่อจัดการบัญชีและติดตามการเช่าของคุณ</p>
      </div>

      <div class="input-box">
        <div class="input-field">
          <input type="text" placeholder="ชื่อผู้ใช้" name="username" id="username" required>
        </div>
      </div>

      <div class="input-box">
        <div class="input-field">
          <input type="password" placeholder="รหัสผ่าน" name="password" id="password" required>
        </div>
      </div>

      <div class="input-box">
        <div class="input-field">
          <button id="submitBtn" type="submit" class="btn">เข้าสู่ระบบ</button>
          <% if (typeof error !=='undefined' && error) { %>
            <p id="error"><%= error %></p>
          <% } %>
        </div>
      </div>
    </form>

    <hr class="divider">

    <div class="login-links">
      <a href="/forgetpassword">ลืมรหัสผ่านใช่ไหม</a>
      <div class="login-links__register">
        <p>ไม่มีบัญชีใช่ไหม</p>
        <a href="/register">สมัครบัญชี</a>
      </div>
    </div>
  </div>
</main>


<script src="/js/script.js"></script>
</body>

</html>
