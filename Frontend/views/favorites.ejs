<%- include('includes/head') %>
  <link rel="stylesheet" href="/styles/review.css">
  <link rel="stylesheet" href="/styles/favorites.css">
  </head>

  <body>
    <%- include('includes/nav') %>

      <main>
        <section class="index product1 favorites-page">
          <div class="favorites-heading">
            <h2>ชุดที่ถูกใจ <span>(<%= favorites ? favorites.length : 0 %> รายการ)</span></h2>
          </div>

          <!-- 🧺 container สำหรับสินค้าที่โหลดจาก API -->
          <div class="pro-container">
            <% if (favorites && favorites.length> 0) { %>
              <% favorites.forEach(fav=> { %>
                <%- include('includes/productCard', { product: fav.product, likedIds: likedIds }) %>

                  <% }) %>
                    <% } else { %>
                      <div class="wishlist-empty">
                        <p>คุณยังไม่ได้บันทึกชุดที่ถูกใจไว้ในรายการ ลองเลือกดูสินค้าแล้วกดหัวใจเพื่อเก็บชุดโปรดไว้เช่าครั้งหน้า</p>
                        <a href="/products">เริ่มเลือกชุด</a>
                      </div>
                      <% } %>
          </div>
        </section>
      </main>

      <%- include('includes/footer') %>
        <%- include('includes/chatWidget') %>

          <script src="/js/script.js"></script>
          <script src="/js/heart-toggle.js"></script>
  </body>

  </html>
