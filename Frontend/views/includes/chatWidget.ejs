<link rel="stylesheet" href="/styles/chatWidget.css">
<div id="chat-widget">
  <button id="chat-toggle" aria-label="เปิดแชทกับแอดมิน">
    <i class="bx bx-message-rounded-dots"></i>
    <span>แชทกับแอดมิน</span>
  </button>
  <div id="chat-box" class="hidden">
    <div id="chat-header">
      <div>
        <span>Support</span>
        <p>ฝ่ายบริการลูกค้า</p>
      </div>
      <button id="chat-close" type="button" aria-label="ปิดแชท">
        <i class="bx bx-x"></i>
      </button>
    </div>
    <div id="chat-messages"></div>
    <form id="chat-form">
      <input id="chat-input" type="text" placeholder="พิมพ์ข้อความ..." autocomplete="off" />
      <button type="submit">ส่ง</button>
    </form>
  </div>
</div>

<script type="module" src="/js/chatWidget.js"></script>
