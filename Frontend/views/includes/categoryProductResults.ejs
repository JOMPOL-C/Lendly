<% if (products && products.length > 0) { %>
  <% products.forEach(product => { %>
    <%- include('productCard', { product, likedIds }) %>
  <% }) %>
<% } else { %>
  <div class="category-empty-state">
    <i class="bx bx-search-alt"></i>
    <h3>ไม่พบชุดที่ตรงกับตัวกรอง</h3>
    <p>ลองล้างตัวกรอง หรือปรับสัดส่วนเพื่อดูสินค้าเพิ่มเติม</p>
    <a href="/products">ล้างตัวกรอง</a>
  </div>
<% } %>
