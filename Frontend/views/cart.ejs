<%- include('includes/head') %>
<link rel="stylesheet" href="/styles/cart.css">
</head>

<body>
  <%- include('includes/nav') %>
  <% const cartItems = cart?.items || []; %>
  <% const itemCount = cartItems.length; %>
  <% const formatCartDate = (date) => date ? new Date(date).toISOString().split('T')[0] : '-'; %>
  <main>
    <section class="index product1 cart-page">
      <div class="cart-heading">
        <h2>ตะกร้าสินค้า <span>(<%= itemCount %> รายการ)</span></h2>
      </div>

      <% if (itemCount > 0) { %>
        <div class="cart-shell">
          <form id="rentalForm" class="cart-form">
            <div class="cart-toolbar">
              <label class="cart-select-all" for="selectAll">
                <input type="checkbox" id="selectAll" />
                <span>เลือกสินค้าทั้งหมด</span>
              </label>
              <p>เลือกชุดที่ต้องการเช่า แล้วไปต่อที่หน้าชำระเงินได้ทันที</p>
            </div>

            <div class="cart-list">
              <% cartItems.forEach(item => { %>
                <article class="cart-card">
                  <label class="cart-check" aria-label="เลือก <%= item.product.product_name %>">
                    <input type="checkbox" name="selected" value="<%= item.cartItem_id %>" />
                  </label>

                  <a href="/api/products/<%= item.product.product_id %>" class="cart-media">
                    <img src="<%= item.product.images[0]?.image_url || '/images/no-image.png' %>" alt="<%= item.product.product_name %>">
                  </a>

                  <div class="cart-copy">
                    <div class="cart-copy-top">
                      <a href="/api/products/<%= item.product.product_id %>" class="cart-product-link"><%= item.product.product_name %></a>
                      <p class="cart-price">ราคาเช่า <strong><%= item.displayPrice %></strong></p>
                    </div>

                    <div class="cart-meta">
                      <div>
                        <span>วันที่เช่า</span>
                        <strong><%= formatCartDate(item.startDate) %></strong>
                      </div>
                      <div>
                        <span>วันที่คืน</span>
                        <strong><%= formatCartDate(item.endDate) %></strong>
                      </div>
                      <div>
                        <span>รูปแบบ</span>
                        <strong><%= item.mode === "test" ? "เทส" : "ไพร" %></strong>
                      </div>
                    </div>
                  </div>

                  <div class="cart-item-actions">
                    <span class="cart-mode-badge"><%= item.mode === "test" ? "โหมดเทส" : "โหมดไพร" %></span>
                    <button type="button" class="remove-btn" data-id="<%= item.cartItem_id %>" aria-label="ลบ <%= item.product.product_name %> ออกจากตะกร้า">
                      <i class='bx bx-trash'></i>
                    </button>
                  </div>
                </article>
              <% }) %>
            </div>

            <div class="cart-actions">
              <button type="button" id="rentSelectedBtn" class="btn-rent">เช่าสินค้าที่เลือก</button>
            </div>
          </form>
        </div>
      <% } else { %>
        <div class="pro-container">
          <div class="wishlist-empty cart-empty">
            <p>คุณยังไม่ได้เพิ่มสินค้าไว้ในตะกร้า ลองเลือกดูสินค้าที่ต้องการ แล้วเพิ่มลงตะกร้าเพื่อดำเนินการเช่าต่อได้เลย</p>
            <a href="/products">เริ่มเลือกชุด</a>
          </div>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('includes/footer') %>
  <%- include('includes/chatWidget') %>
  <script src="/js/script.js"></script>

  <script>
    // ✅ ลบสินค้าออกจากตะกร้า
    document.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', async e => {
        const id = e.currentTarget.dataset.id;
        const res = await fetch(`/api/cart/${id}`, { method: 'DELETE' });
        const data = await res.json();
        showTooltip(data.message || "ลบสินค้าออกจากตะกร้าแล้ว", "success");
        setTimeout(() => location.reload());
      });
    });

    // ✅ ปุ่มเช่าสินค้าที่เลือก
    document.getElementById("rentSelectedBtn")?.addEventListener("click", async () => {
      const selected = Array.from(document.querySelectorAll("input[name=selected]:checked"))
        .map(chk => parseInt(chk.value));

      if (!selected.length)
        return showTooltip("กรุณาเลือกสินค้าที่ต้องการเช่า", "warning");

      try {
        const res = await fetch("/api/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ selectedItems: selected }),
        });

        const data = await res.json();

        if (!res.ok) {
          showTooltip(data.message || "กรุณาแก้ไขโปรไฟล์ก่อนเช่าสินค้า", "warning");
          if (data.message?.includes("โปรไฟล์ของคุณยังไม่สมบูรณ์")) {
            setTimeout(() => window.location.href = "/profile", 1200);
          }
          return;
        }

        const orderId = data.order.order_id;
        showTooltip("สร้างคำสั่งเช่าสำเร็จ กำลังไปหน้าชำระเงิน...", "success");
        setTimeout(() => window.location.href = `/payment?orderId=${orderId}`);
      } catch (err) {
        console.error("❌ สร้างคำสั่งซื้อไม่สำเร็จ:", err);
        showTooltip("เกิดข้อผิดพลาดในการสร้างคำสั่งซื้อ", "error");
      }
    });

    // ✅ Checkbox เลือกทั้งหมด
    const selectAll = document.getElementById("selectAll");
    if (selectAll) {
      selectAll.addEventListener("change", () => {
        const allItems = document.querySelectorAll("input[name='selected']");
        allItems.forEach(chk => chk.checked = selectAll.checked);
      });

      document.querySelectorAll("input[name='selected']").forEach(chk => {
        chk.addEventListener("change", () => {
          const all = document.querySelectorAll("input[name='selected']");
          const checked = document.querySelectorAll("input[name='selected']:checked");
          selectAll.checked = (all.length === checked.length);
        });
      });
    }
  </script>
</body>
</html>
