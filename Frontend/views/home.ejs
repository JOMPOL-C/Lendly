<%- include('includes/head') %>
<link rel="stylesheet" href="/styles/favorites.css">
</head>

<body>
  <%- include('includes/nav') %>
  <main>
    <section id="banner" class="home-hero section-p1">
      <%
        const defaultVerboseHeroSubtitle = 'เลือกชุดแฟนซี คอสเพลย์ และพร็อพที่ใช่ พร้อมดูราคา ตรวจสัดส่วน และคุยกับร้านได้ในที่เดียว';
        const heroTitle = homeBanner?.title || 'เช่าชุดให้พร้อมก่อนวันจริง';
        const rawHeroSubtitle = homeBanner?.subtitle?.trim();
        const heroSubtitle = rawHeroSubtitle && rawHeroSubtitle !== defaultVerboseHeroSubtitle
          ? rawHeroSubtitle
          : 'เลือกชุดที่ใช่ ดูราคา และคุยกับร้านได้ในที่เดียว';
        const heroLink = homeBanner?.link_url || '/products';
        const heroButtonText = homeBanner?.button_text || 'ดูชุดทั้งหมด';
      %>
      <video autoplay muted loop playsinline id="banner-video">
        <source src="/videos/banner-bg.mp4" type="video/mp4">
      </video>
      <div class="hero-inner">
        <div class="hero-content">
          <span class="hero-kicker">เช่าชุดง่ายในที่เดียว</span>
          <h1 class="hero-title-glow"><span><%= heroTitle %></span></h1>
          <p><%= heroSubtitle %></p>
          <div class="hero-actions">
            <a href="<%= heroLink %>" class="hero-btn hero-btn-primary"><%= heroButtonText %></a>
          </div>
          <div class="hero-trust">
            <span><i class="bx bx-calendar-check"></i> ดูวันว่างได้</span>
            <span><i class="bx bx-message-rounded-dots"></i> คุยกับร้านได้</span>
          </div>
        </div>

        <% if (homeBanners && homeBanners.length > 0) { %>
          <a href="<%= heroLink %>" class="hero-featured-product hero-featured-gallery" aria-label="<%= heroTitle %>">
            <div class="hero-featured-media hero-featured-stack" aria-label="รูปตัวอย่างแบนเนอร์หน้าหลัก">
              <% homeBanners.slice(0, 6).forEach((banner, index) => { %>
                <div class="hero-stack-panel <%= index === 0 ? 'is-expanded' : '' %>">
                  <img src="<%= banner.image_url %>" alt="<%= banner.title %>" class="hero-stack-image hero-stack-image-<%= index + 1 %>">
                </div>
              <% }) %>
            </div>
          </a>
        <% } else { %>
          <div class="hero-featured-product hero-featured-empty" aria-label="ยังไม่มีแบนเนอร์">
            <div class="hero-featured-media">
              <img src="/images/no-image.png" alt="ตัวอย่างชุด">
            </div>
            <div class="hero-featured-info">
              <span>ยังไม่มีแบนเนอร์</span>
              <h2>เพิ่มรูปคนใส่ชุดจากหน้าแอดมิน</h2>
              <p>ไปที่แอดมินเพื่ออัปโหลดรูป lookbook สำหรับหน้าแรก</p>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <section id="new_product" class="section-p1 product1">
      <div class="section-heading">
        <span class="section-label">New arrivals</span>
        <h2>ชุดพร้อมให้เช่า</h2>
        <p>เลือกดูชุดยอดนิยม หรือไปยังหน้าสินค้าทั้งหมดเพื่อกรองตามสไตล์และขนาดที่ต้องการ</p>
      </div>

      <div class="category-shortcuts" aria-label="หมวดหมู่แนะนำ">
        <a href="/products">คอสเพลย์</a>
        <a href="/products">แฟนซี</a>
        <a href="/products">ชุดไทย</a>
        <a href="/products">เดรส</a>
      </div>

      <div class="pro-container">
        <% if (products && products.length > 0) { %>
          <% products.slice(0,4).forEach(product => { %>
            <%- include('includes/productCard', { product }) %>
          <% }) %>
        <% } else { %>
          <div class="home-empty-state">
            <i class="bx bx-closet"></i>
            <h3>ยังไม่มีสินค้าในระบบ</h3>
            <p>เมื่อร้านเพิ่มชุดใหม่ สินค้าจะแสดงที่นี่ทันที</p>
            <a href="/products">ไปหน้าสินค้าทั้งหมด</a>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('includes/footer') %>
  <%- include('includes/chatWidget') %>

  <script src="/js/script.js"></script>
  <script src="/js/heart-toggle.js"></script>
</body>
</html>
